:root{color-scheme:light;--ink:#18283c;--muted:#62748a;--line:#dde5ed;--motor:#0d9488;--hot:#dc503e;--cold:#2563eb}body{margin:0;background:#f5f7fa;color:var(--ink);font-family:var(--bs-font-sans-serif);font-size:12px}h2,h3,p{margin:0}h2{font-size:14px;font-weight:650}h3{font-size:14px;margin-top:16px}label{font-size:11px;font-weight:500}output{font-variant-numeric:tabular-nums}.muted,small{color:var(--muted);font-size:11px}.console{height:100dvh;display:flex;flex-direction:column}.console header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 16px;background:#fff;border-bottom:1px solid var(--line)}.console header>strong{font-size:15px;letter-spacing:.06em}.console header .badge{font-weight:550;font-size:10px}.btn{white-space:nowrap;--bs-btn-font-size:11px;--bs-btn-padding-y:5px;--bs-btn-padding-x:9px}.btn-outline-secondary{--bs-btn-color:#44556c;--bs-btn-border-color:#cbd5e1;--bs-btn-hover-bg:#edf2f7;--bs-btn-hover-color:#18283c;--bs-btn-hover-border-color:#a9b7c8}.btn:disabled{opacity:.48}#stop{font-weight:650}.form-control,.form-select{font-size:11px;min-width:0;border-color:#cbd5e1}.form-select{padding-right:26px}.form-range{height:18px;margin:0;min-width:0}.form-range::-webkit-slider-thumb{background:var(--motor);width:13px;height:13px;margin-top:-3px}.form-range::-webkit-slider-runnable-track{height:7px;background:#e2e8f0}.form-range::-moz-range-thumb{background:var(--motor);width:13px;height:13px}#thermal::-webkit-slider-thumb{background:var(--hot)}#lead::-webkit-slider-thumb,#motion::-webkit-slider-thumb{background:#6476bc}main{padding:10px 14px;display:grid;grid-template-rows:auto auto minmax(205px,1fr) auto;gap:10px;flex:1;min-height:0;width:100%;max-width:1500px;margin:auto}.card{padding:12px;border:1px solid var(--line);border-radius:10px;background:#fff;min-width:0;min-height:0;box-shadow:0 2px 4px #18334a04}.sectionhead{display:flex;align-items:center;justify-content:space-between;gap:8px}.toolbar{display:flex;gap:7px;align-items:end}.toolbar label{display:grid;gap:4px;min-width:0;flex:1}.toolbar .seed{flex:0 0 62px}.toolbar input{width:100%}.connection-card{display:grid;gap:6px}#connectionDetail{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.rig-line{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;margin:8px 0;position:relative}.rig-line:before{content:'';position:absolute;left:5%;right:5%;top:40px;height:2px;background:#d9e5e9}.channel{display:grid;gap:4px;min-width:0;position:relative}.actuator{--drive:var(--motor);position:relative;isolation:isolate;overflow:hidden;background:#f3f8f8;border:1px solid #cce1df;border-radius:8px;height:82px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;padding:6px}.level-fill{position:absolute;inset:auto 0 0;height:var(--level,0%);background:var(--drive);opacity:.2;transition:height .18s linear;z-index:-1}.actuator.active{border-color:var(--drive);box-shadow:0 0 0 2px color-mix(in srgb,var(--drive) 12%,transparent)}.actuator output{font-size:19px;font-weight:600}.actuator strong{font-size:12px}.actuator small{font-size:10px;margin-left:5px;font-weight:400}.peltier{background:#f4f5f7;border-color:#dce0e6}.peltier.hot{--drive:var(--hot);background:#fff5f2}.peltier.cold{--drive:var(--cold);background:#eff6ff}.peltier.off{--drive:#8b97a7}#rigPolarity{font-size:9px;font-weight:600}.level-label{display:flex;justify-content:space-between;color:var(--muted)}.level-label output{color:var(--ink);font-weight:600}progress{width:100%;height:6px;border:0;border-radius:8px;overflow:hidden;appearance:none;background:#e8edf2;accent-color:var(--motor)}progress::-webkit-progress-bar{background:#e8edf2;border-radius:8px}progress::-webkit-progress-value{background:var(--drive,var(--motor));border-radius:8px;transition:width .18s linear}progress::-moz-progress-bar{background:var(--drive,var(--motor))}.actuator progress{flex-shrink:0}.master-row{display:grid;grid-template-columns:auto minmax(80px,1fr) 35px minmax(120px,1fr);align-items:center;gap:10px;border-top:1px solid var(--line);padding-top:7px}#settingsStatus{font-size:10px;color:var(--muted);text-align:right}.lead-row{display:grid;grid-template-columns:145px 1fr 55px;gap:10px;align-items:center;margin-top:5px}.lead-row output{text-align:right;font-size:11px;font-weight:600}.preset-row{display:flex;gap:6px;align-items:center;padding-top:7px;margin-top:6px;border-top:1px solid var(--line)}.preset-row input,.preset-row select{width:120px;flex:1}.preset-row span{font-size:10px;max-width:100px;color:#087461}.trial-row{display:flex;gap:10px;align-items:center;margin-top:6px}.trial-row progress{flex:1}.trial-row span{font-size:10px;width:125px;text-align:right;color:var(--muted)}.columns{display:grid;grid-template-columns:1.1fr 1fr;gap:10px;min-height:0}.operation-card{display:flex;flex-direction:column;gap:8px}.buttons{display:flex;gap:6px;align-items:center}.debug-heading{margin-top:auto}.check{display:flex;gap:5px;align-items:center;font-size:10px}.check input{margin:0}.debug{display:grid;grid-template-columns:repeat(4,1fr);gap:5px}.debug .btn{padding:7px 4px;font-size:10px}.debug [data-condition=B]{--bs-btn-color:#ae3b29;--bs-btn-border-color:#eecbc3}.debug [data-condition=C]{--bs-btn-color:#08796c;--bs-btn-border-color:#b6dcd6}.debug [data-condition=D]{--bs-btn-color:#6b50a1;--bs-btn-border-color:#d6c9ec}#phase,#progress{font-size:11px;color:var(--muted);line-height:1.3;overflow-wrap:anywhere}#phase{min-height:14px}.preview-card{display:flex;flex-direction:column;gap:8px}.participant{background:#fff;color:var(--ink);display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:20px;gap:10px;border:1px solid var(--line);border-radius:7px;min-height:0}.participant .fixation{font-size:80px;font-weight:300}.participant button{min-width:190px}.participant p{line-height:1.4;color:var(--muted)}.preview-card .participant{flex:1;background:#fafbfd;padding:8px;gap:6px;overflow:auto}.preview-card .participant h2{font-size:16px}.preview-card .participant p{font-size:11px}.preview-card .participant button{font-size:11px;min-width:150px;padding:4px 8px}.console footer{display:flex;justify-content:space-between;align-items:center;gap:6px}.console footer .btn{font-size:10px;padding:3px 8px}dialog{width:min(640px,90vw);max-height:80vh;overflow:auto;border:1px solid var(--line);border-radius:12px;background:#fff;color:var(--ink);padding:20px;font-size:13px;box-shadow:0 20px 80px #15304a30}dialog::backdrop{background:#253b5860}dialog p{margin:12px 0;line-height:1.5}table{text-align:center;margin:12px 0}pre{white-space:pre-wrap;max-height:160px;overflow:auto;font-size:11px;background:#f5f7fa;padding:10px;border-radius:6px;color:var(--muted)}
@media(max-width:760px){main{padding:6px;gap:6px;grid-template-rows:auto auto minmax(190px,1fr) auto}.card{padding:8px}.toolbar{gap:4px;flex-wrap:wrap}.toolbar .seed{flex:0 0 48px}.toolbar .btn{font-size:10px;padding:5px}.console header{padding:6px 9px}.console header>strong{font-size:12px}.columns{gap:6px;grid-template-columns:1fr 1fr}.rig-line{gap:5px;margin:5px 0}.actuator{height:70px;padding:4px;gap:2px}.actuator strong{font-size:11px}.actuator small{font-size:9px;margin-left:2px}.actuator output{font-size:16px}.channel .btn{font-size:10px;padding:4px 2px}.level-label{font-size:10px}.master-row{grid-template-columns:auto 1fr 30px;gap:6px}#settingsStatus{display:none}.lead-row{grid-template-columns:137px 1fr 43px;gap:6px}.lead-row label{font-size:10px}.preset-row{gap:4px}.preset-row input,.preset-row select{width:60px;font-size:10px}.preset-row .btn{font-size:10px;padding:5px}.operation-card{gap:6px}.operation-card .sectionhead,.preview-card .sectionhead{flex-wrap:wrap;gap:4px}.operation-card .btn{font-size:10px;padding:5px}.operation-card .buttons{gap:4px}.debug{grid-template-columns:1fr 1fr}.preview-card .participant button{min-width:0;width:100%}.console footer .muted{font-size:9px}.console footer .btn{font-size:10px;padding:3px 5px}.console footer .buttons{gap:4px}}
@media(max-width:479px){.console{height:auto;min-height:100dvh}.columns{grid-template-columns:1fr}.preview-card{min-height:200px}.console footer{flex-wrap:wrap}.actuator small{display:none}.lead-row{grid-template-columns:125px 1fr 40px}}
@media(min-width:480px) and (max-height:740px){main{gap:5px;padding:5px 8px}.card{padding:7px}.console header{padding:5px 10px}.actuator{height:64px}.rig-line{margin:5px 0}.operation-card{gap:5px}.lead-row{margin-top:2px}.preset-row{padding-top:4px;margin-top:3px}}
#thermal[data-polarity=C]::-webkit-slider-thumb{background:var(--cold)}#thermal[data-polarity=C]::-moz-range-thumb{background:var(--cold)}
