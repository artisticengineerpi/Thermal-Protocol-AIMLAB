:root{color-scheme:dark;font-family:Segoe UI,Arial,sans-serif;color:#f3eff1;background:#111;accent-color:#ff365b}*{box-sizing:border-box}body{margin:0}button,input,select{font:inherit;color:inherit;background:#211b1e;border:1px solid #5c3843;border-radius:5px;padding:7px 9px;min-width:0}button{cursor:pointer;white-space:nowrap}button:hover{background:#42232f}button:disabled{opacity:.4;cursor:default}button:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid #ff7590;outline-offset:2px}h2,h3,p{margin:0}h2{font-size:14px}h3{font-size:14px;margin-top:16px}label{font-size:12px}progress{width:100%;height:7px;accent-color:#ff365b}input[type=range]{width:100%;padding:0;height:20px;margin:0}input[type=checkbox]{margin:0}output{font-variant-numeric:tabular-nums}.muted,small{color:#ac9ca4;font-size:11px}.console{height:100dvh;display:flex;flex-direction:column;font-size:12px}.console header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 16px;border-bottom:1px solid #4c2833;background:linear-gradient(130deg,#292024,#111);flex:none}.console header>strong{font-size:16px;letter-spacing:1px}.danger{background:#b31d39;border-color:#ff365b;font-weight:700;box-shadow:0 0 16px #ff26422b}.primary{background:#9a1e37;border-color:#ee4c6d}main{padding:10px 14px;display:grid;grid-template-rows:auto auto minmax(215px,1fr) auto;gap:10px;flex:1;min-height:0;width:100%;max-width:1500px;margin:auto}.card{border:1px solid #493039;border-radius:8px;background:linear-gradient(145deg,#201b1e,#161416);padding:12px;min-width:0;min-height:0}.sectionhead{display:flex;align-items:center;justify-content:space-between;gap:10px}.toolbar{display:flex;gap:7px;align-items:end}.toolbar label{display:grid;gap:4px;min-width:0;flex:1}.toolbar input{width:100%}.toolbar .seed{flex:0 0 62px}.toolbar button{padding:7px}.connection-card{display:grid;gap:7px}#connectionDetail{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.rig-line{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px;margin:10px 0;position:relative}.rig-line:before{content:'';position:absolute;left:5%;right:5%;top:48px;height:2px;background:#793245}.channel{display:grid;gap:5px;min-width:0;position:relative}.actuator{--drive:#ff365b;position:relative;isolation:isolate;overflow:hidden;background:#262528;border:1px solid #59515a;border-radius:7px;height:94px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;padding:8px}.level-fill{position:absolute;inset:auto 0 0;height:var(--level,0%);background:var(--drive);opacity:.3;transition:height .18s linear;z-index:-1}.actuator.active{border-color:var(--drive);box-shadow:0 0 14px color-mix(in srgb,var(--drive) 30%,transparent)}.actuator output{font-size:19px}.actuator strong{font-size:13px}.actuator small{margin-left:5px;font-weight:400}.actuator progress{accent-color:var(--drive)}.peltier.hot{--drive:#ff344d}.peltier.cold{--drive:#318eff}.peltier.off{--drive:#777}#rigPolarity{font-size:10px}.level-label{display:flex;justify-content:space-between;color:#b9abb2}.level-label output{color:#fff}.master-row{display:grid;grid-template-columns:auto minmax(100px,1fr) 38px minmax(150px,1fr);align-items:center;gap:12px;border-top:1px solid #3c2931;padding-top:8px}#settingsStatus{font-size:11px;color:#bcaeb5;text-align:right}.trial-row{display:flex;gap:12px;align-items:center;margin-top:8px}.trial-row progress{flex:1}.trial-row span{font-size:11px;width:128px;text-align:right}.columns{display:grid;grid-template-columns:1.1fr 1fr;gap:10px;min-height:0}.operation-card{display:flex;flex-direction:column;gap:10px}.buttons{display:flex;gap:7px;align-items:center}.debug-heading{margin-top:auto}.check{display:flex;gap:5px;align-items:center;font-size:11px}.debug{display:grid;grid-template-columns:repeat(4,1fr);gap:5px}.debug button{padding:9px 4px;font-size:11px}#phase,#progress{font-size:11px;color:#c9b7bf;line-height:1.3;overflow-wrap:anywhere}#phase{min-height:15px}.preview-card{display:flex;flex-direction:column;gap:8px}.participant{background:#111;color:white;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:20px;gap:10px;border:1px solid #33282d;min-height:0}.participant .fixation{font-size:80px;font-weight:300}.participant button{min-width:190px}.participant p{line-height:1.4}.preview-card .participant{flex:1;padding:10px;gap:6px;overflow:auto}.preview-card .participant h2{font-size:16px}.preview-card .participant p{font-size:11px}.preview-card .participant button{font-size:11px;min-width:160px;padding:5px 8px}.console footer{display:flex;justify-content:space-between;align-items:center;gap:8px}.console footer button{font-size:11px;padding:5px 9px}dialog{width:min(640px,90vw);max-height:80vh;overflow:auto;border:1px solid #8d344c;border-radius:10px;background:#1b1719;color:#eee;padding:20px;font-size:13px}dialog::backdrop{background:#000b}dialog p{margin:12px 0;line-height:1.5}table{width:100%;text-align:center;border-collapse:collapse;margin:12px 0}td,th{border-bottom:1px solid #493039;padding:6px}td{color:#ff6c89}pre{white-space:pre-wrap;max-height:160px;overflow:auto;font-size:11px;color:#c9b7bf}@media(min-height:850px){.actuator{height:120px}.rig-line:before{top:60px}.rig-line{margin:14px 0}.card{padding:15px}}@media(max-width:760px){.console{height:auto;min-height:100dvh}.toolbar{flex-wrap:wrap}.toolbar label{flex-basis:150px}.columns{grid-template-columns:1fr}.preview-card{min-height:240px}.rig-line{gap:6px}.channel button{font-size:10px;padding:7px 2px}.master-row{grid-template-columns:auto 1fr 35px}#settingsStatus{grid-column:1/-1;text-align:left}.console footer{flex-wrap:wrap}main{grid-template-rows:auto auto auto auto}.actuator small{display:block;margin:0}.actuator output{font-size:15px}}@media(min-width:761px) and (max-height:710px){main{gap:6px;padding:6px 12px}.card{padding:8px}.actuator{height:75px}.rig-line{margin:6px 0}.operation-card{gap:6px}.console header{padding:6px 14px}}

.lead-row{display:grid;grid-template-columns:auto 1fr 65px;gap:12px;align-items:center;margin-top:6px}.lead-row output{text-align:right;font-size:11px}

.preset-row{display:flex;gap:6px;align-items:center;margin-top:6px}.preset-row input,.preset-row select{width:130px;flex:1}.preset-row button{padding:5px 8px}.preset-row span{font-size:10px;max-width:130px}.rig-card .actuator{height:80px}.rig-card .rig-line{margin:7px 0}.rig-card .lead-row{margin-top:3px}
@media(min-width:480px) and (max-width:760px){.console{height:100dvh;min-height:0;font-size:11px}main{grid-template-rows:auto auto minmax(190px,1fr) auto;padding:6px;gap:6px}.card{padding:8px}.columns{grid-template-columns:1fr 1fr;gap:6px}.preview-card{min-height:0}.console header{padding:6px 9px}.console header>strong{font-size:12px}.toolbar{gap:4px}.toolbar label{flex:1}.toolbar .seed{flex:0 0 48px}.toolbar button{padding:5px;font-size:10px}.master-row{grid-template-columns:auto 1fr 30px;gap:6px}#settingsStatus{display:none}.rig-card .actuator{height:65px}.rig-card .rig-line{gap:5px;margin:5px 0}.actuator strong{font-size:11px}.level-label{font-size:10px}.lead-row{gap:6px;grid-template-columns:auto 1fr 45px}.lead-row label{font-size:10px}.preset-row{gap:4px}.preset-row input,.preset-row select{width:75px;padding:5px;font-size:10px}.preset-row button{font-size:10px;padding:5px}.operation-card{gap:6px}.operation-card .sectionhead{flex-wrap:wrap;gap:4px}.operation-card .buttons{gap:4px}.operation-card button{font-size:10px;padding:5px}.debug{grid-template-columns:1fr 1fr}.preview-card .sectionhead{flex-wrap:wrap;gap:3px}.preview-card .participant{padding:5px}.preview-card .participant button{min-width:0;width:100%}.console footer .muted{font-size:9px}.console footer{gap:3px}.console footer button{font-size:10px;padding:4px}.console footer .buttons{gap:4px}}
@media(min-width:480px) and (max-width:760px){.rig-card .peltier{gap:2px;padding:4px}.rig-card .peltier small{display:inline;margin-left:3px}.rig-card .peltier output{font-size:14px}.rig-card .peltier progress{flex-shrink:0;height:5px}}
